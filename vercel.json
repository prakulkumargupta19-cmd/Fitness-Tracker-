{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "frontend1",
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.py"
    }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 30,
      "excludeFiles": "{.git/**,.playwright-mcp/**,artifacts/**,docs/**,Fit-Track/**,frontend1/**,tests/**,**/__pycache__/**,**/*.pyc}"
    }
  }
}
