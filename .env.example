APP_ENV=development
SECRET_KEY=replace-with-a-long-random-secret
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=fitness_tracker_auth
FLASK_HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=false
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax
CORS_ALLOWED_ORIGINS=http://localhost:8080

# Configure an SMTP account for signup, login, and password-reset OTPs.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURITY=starttls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# Development debugging; when true, OTPs are logged to the backend terminal as well as emailed.
OTP_LOG_TO_TERMINAL=false
FITNESS_TEST_MODE=false

# Optional one-time initial administrator (password must be at least 12 chars).
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
