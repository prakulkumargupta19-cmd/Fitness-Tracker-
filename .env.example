# Local development uses SQLite and does not need Supabase.
DATABASE_BACKEND=sqlite
LOCAL_DB_PATH=backend/fitness_tracker.sqlite3

# For Vercel, use Supabase Dashboard > Connect > Transaction pooler (port 6543).
# Set DATABASE_BACKEND=postgres in production and provide the PostgreSQL URL.
SUPABASE_DB_URL=postgresql://postgres.your-project:your-password@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require
DB_CONNECT_TIMEOUT=5
DB_POOL_MIN=0
DB_POOL_MAX=1
DB_POOL_TIMEOUT=15

# Optional private Supabase Storage for uploads and generated files.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
FIT_TRACK_STORAGE_BUCKET=fit-track-uploads
FIT_TRACK_MAX_UPLOAD_MB=16

# Flask/session
APP_ENV=development
APP_VERSION=1.0.0
SECRET_KEY=replace-with-a-long-random-secret
FLASK_HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=false
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax

# Set FRONTEND_URL to the exact frontend origin in production.
FRONTEND_URL=
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5501,http://127.0.0.1:5501

# SMTP settings for signup, login, and password-reset email delivery.
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_SECURITY=starttls
MAIL_TIMEOUT=20
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# Optional one-time local creation of the initial admin. Never configure the
# password in frontend settings or commit a populated .env file.
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Enable only in isolated tests; OTPs are never logged.
FITNESS_TEST_MODE=false
