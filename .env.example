# Copy to .env for local development. In Vercel, add each variable in
# Project Settings > Environment Variables; Vercel does not load this file.

APP_ENV=development
DATABASE_BACKEND=sqlite
SECRET_KEY=replace-with-a-random-secret-of-at-least-32-bytes

# Required for hosted Vercel deployments (Supabase PostgreSQL transaction pooler).
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
DB_POOL_MIN=0
DB_POOL_MAX=1

# Required for hosted uploads.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
FIT_TRACK_STORAGE_BUCKET=fit-track-uploads
FIT_TRACK_MAX_UPLOAD_MB=16

# Set this separately for each Vercel environment to the deployed site origin.
FRONTEND_URL=https://your-project.vercel.app
FITNESS_TEST_MODE=false

# Optional until OTP and account notification email is needed.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURITY=starttls
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=replace-with-smtp-password-or-google-app-password
MAIL_FROM=your-email@example.com
MAIL_TIMEOUT=10
